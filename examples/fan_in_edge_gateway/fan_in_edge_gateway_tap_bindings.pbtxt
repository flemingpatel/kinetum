# Fan-In Edge Gateway - Exact DPDK TAP Deployment Bindings
#
# Logical pipeline:
#   wan0 -> rx0 -> parse0 -> acl0 \
#                                 -> NAT -> QoS -> lan0 (tx, r2)
#   wan1 -> rx1 -> parse1 -> acl1 /
#
# TAP mapping:
#   wan0 -> neb_rx0
#   wan1 -> neb_rx1
#   lan0 -> neb_tx
#
# Every provider instance, queue-zero stream, storage domain, and stage
# execution owner is explicit.
#
# Usage:
#   kinetum_gluon --axiom fan_in_edge_gateway.axiom.pbtxt \
#                --hw hardware_inventory_tap.pbtxt \
#                --bindings fan_in_edge_gateway_tap_bindings.pbtxt \
#                --out plan.pbtxt --regions 3

process_facility_instances {
  facility_instance_id: "facility_dpdk_0"
  configuration {
    [type.googleapis.com/kinetum.facility.dpdk.v1.DpdkFacilityConfig] {}
  }
}

io_driver_instances {
  io_driver_instance_id: "io_dpdk_0"
  facility_instance_ids: "facility_dpdk_0"
  configuration {
    [type.googleapis.com/kinetum.io.dpdk.v1.DpdkDriverConfig] {
      ports {
        driver_port_id: "lan0"
        tap { interface_name: "neb_tx" }
      }
      ports {
        driver_port_id: "wan0"
        tap { interface_name: "neb_rx0" }
      }
      ports {
        driver_port_id: "wan1"
        tap { interface_name: "neb_rx1" }
      }
    }
  }
}

packet_storage_domains {
  storage_domain_id: "storage_dpdk_0"
  facility_instance_ids: "facility_dpdk_0"
  configuration {
    [type.googleapis.com/kinetum.storage.dpdk.v1.DpdkStorageConfig] {
      cache_size: 256
    }
  }
  buffer_count: 131071
  data_room_bytes: 2048
  headroom_bytes: 128
  alignment_bytes: 64
  host_numa_node: 0
}

execution_provider_instances {
  execution_provider_instance_id: "execution_cpu_0"
  configuration {
    [type.googleapis.com/kinetum.execution.cpu.v1.CpuExecutionConfig] {}
  }
}

logical_port_bindings {
  logical_name: "wan0"
  io_driver_instance_id: "io_dpdk_0"
  driver_port_id: "wan0"
  direction: PORT_DIRECTION_RX_ONLY
  mtu: 1500
}
logical_port_bindings {
  logical_name: "wan1"
  io_driver_instance_id: "io_dpdk_0"
  driver_port_id: "wan1"
  direction: PORT_DIRECTION_RX_ONLY
  mtu: 1500
}
logical_port_bindings {
  logical_name: "lan0"
  io_driver_instance_id: "io_dpdk_0"
  driver_port_id: "lan0"
  direction: PORT_DIRECTION_TX_ONLY
  mtu: 1500
}

io_stream_bindings {
  logical_name: "wan0"
  direction: IO_STREAM_DIRECTION_RX
  queues { driver_queue_id: 0 descriptor_count: 1024 rx_storage_domain_id: "storage_dpdk_0" }
  steering { kind: TRAFFIC_STEERING_KIND_NONE }
}
io_stream_bindings {
  logical_name: "wan1"
  direction: IO_STREAM_DIRECTION_RX
  queues { driver_queue_id: 0 descriptor_count: 1024 rx_storage_domain_id: "storage_dpdk_0" }
  steering { kind: TRAFFIC_STEERING_KIND_NONE }
}
io_stream_bindings {
  logical_name: "lan0"
  direction: IO_STREAM_DIRECTION_TX
  queues {
    driver_queue_id: 0
    descriptor_count: 1024
    tx_storage { storage_domain_ids: "storage_dpdk_0" }
  }
  steering { kind: TRAFFIC_STEERING_KIND_NONE }
}

stage_execution_bindings {
  logical_stage_id: "rx0"
  execution_provider_instance_id: "execution_cpu_0"
}
stage_execution_bindings {
  logical_stage_id: "rx1"
  execution_provider_instance_id: "execution_cpu_0"
}
stage_execution_bindings {
  logical_stage_id: "parse0"
  execution_provider_instance_id: "execution_cpu_0"
}
stage_execution_bindings {
  logical_stage_id: "parse1"
  execution_provider_instance_id: "execution_cpu_0"
}
stage_execution_bindings {
  logical_stage_id: "acl0"
  execution_provider_instance_id: "execution_cpu_0"
}
stage_execution_bindings {
  logical_stage_id: "acl1"
  execution_provider_instance_id: "execution_cpu_0"
}
stage_execution_bindings {
  logical_stage_id: "nat"
  execution_provider_instance_id: "execution_cpu_0"
}
stage_execution_bindings {
  logical_stage_id: "qos"
  execution_provider_instance_id: "execution_cpu_0"
}
stage_execution_bindings {
  logical_stage_id: "tx"
  execution_provider_instance_id: "execution_cpu_0"
}

storage_transition_bindings {
  transition_id: "acl0_lane_0_to_nat_lane_0_share"
  from_endpoint { stage { logical_stage_id: "acl0" lane_id: "lane_0" } }
  to_endpoint { stage { logical_stage_id: "nat" lane_id: "lane_0" } }
  from_storage_domain_id: "storage_dpdk_0"
  to_storage_domain_id: "storage_dpdk_0"
  configuration {
    [type.googleapis.com/kinetum.transition.core.v1.ZeroCopyShareConfig] {}
  }
}

storage_transition_bindings {
  transition_id: "acl1_lane_0_to_nat_lane_0_share"
  from_endpoint { stage { logical_stage_id: "acl1" lane_id: "lane_0" } }
  to_endpoint { stage { logical_stage_id: "nat" lane_id: "lane_0" } }
  from_storage_domain_id: "storage_dpdk_0"
  to_storage_domain_id: "storage_dpdk_0"
  configuration {
    [type.googleapis.com/kinetum.transition.core.v1.ZeroCopyShareConfig] {}
  }
}

# Exact lane-local lifecycle-memory budgets. The context bounds cover the
# modules' fixed preallocated cache/session/flow tables; each epoch arena is a
# 1 MiB deployment limit for one immutable policy artifact.
module_context_resource_bindings {
  logical_stage_id: "acl0"
  lane_id: "lane_0"
  context_memory_capacity_bytes: 1048576
  epoch_arena_capacity_bytes: 1048576
}
module_context_resource_bindings {
  logical_stage_id: "acl1"
  lane_id: "lane_0"
  context_memory_capacity_bytes: 1048576
  epoch_arena_capacity_bytes: 1048576
}
module_context_resource_bindings {
  logical_stage_id: "nat"
  lane_id: "lane_0"
  context_memory_capacity_bytes: 16777216
  epoch_arena_capacity_bytes: 1048576
}
module_context_resource_bindings {
  logical_stage_id: "qos"
  lane_id: "lane_0"
  context_memory_capacity_bytes: 16777216
  epoch_arena_capacity_bytes: 1048576
}
