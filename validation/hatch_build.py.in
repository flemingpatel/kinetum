"""Package private validation helpers with an explicit native wheel tag."""

from typing import Any

from hatchling.builders.hooks.plugin.interface import BuildHookInterface


class validation_wheel(BuildHookInterface):
    """Declare platform-specific resources with no Python extension ABI."""

    def initialize(self, version: str, build_data: dict[str, Any]) -> None:
        """Set native wheel metadata from the selected CMake build's platform."""
        build_data["pure_python"] = False
        build_data["tag"] = "py3-none-@KINETUM_VALIDATION_WHEEL_PLATFORM@"
